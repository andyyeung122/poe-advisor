# Copy to .env and fill in.

# Claude API key (https://platform.claude.com). Only for `python -m poe_advisor chat`;
# leave empty when you chat through Claude Code on a Claude Pro/Max plan.
ANTHROPIC_API_KEY=

# Your account (with the #1234 discriminator) and main character, so `chat` loads them on start.
POE_ACCOUNT=
POE_CHARACTER=

# League for every lookup. Empty = current softcore trade challenge league.
# Override per run with --league, or mid-chat with /league <name>.
POE_LEAGUE=

# pc, xbox, or sony
POE_REALM=pc

# Optional: lets pathofexile.com read a private profile. Treat it like a password;
# it gives full access to your account session. Leave empty if your Characters tab is public.
POESESSID=

# GGG asks API consumers to identify themselves; put an email or Discord handle here.
POE_ADVISOR_CONTACT=

# Model and reasoning effort (low | medium | high | xhigh | max).
POE_ADVISOR_MODEL=claude-opus-5-5
POE_ADVISOR_EFFORT=medium

# Claude's server-side web search/fetch (billed per search). true/false
POE_ADVISOR_WEB_SEARCH=true

# Turso (https://turso.tech): stores past-league price history so it is fetched once, not every question.
# Leave empty to fetch past leagues from poe.ninja each time (cached on disk for a day).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
